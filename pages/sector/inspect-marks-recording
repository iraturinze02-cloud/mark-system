
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inspect Marks Recording | Fila Grades System</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        :root {
            --primary: #174ea6;
            --primary-dark: #123b80;
            --primary-light: #eaf2ff;
            --background: #f4f7fb;
            --white: #ffffff;
            --text: #172b4d;
            --muted: #718096;
            --border: #e3e9f2;
            --success: #16834a;
            --success-bg: #e8f7ee;
            --warning: #b7791f;
            --warning-bg: #fff7e5;
            --danger: #c53030;
            --danger-bg: #fff0f0;
            --shadow: 0 4px 18px rgba(20, 45, 90, .07);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--background);
            color: var(--text);
            min-height: 100vh;
        }

        button, input, select {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        .topbar {
            background: var(--white);
            padding: 17px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 20;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-icon {
            width: 43px;
            height: 43px;
            border-radius: 12px;
            background: var(--primary);
            color: white;
            display: grid;
            place-items: center;
            font-size: 19px;
        }

        .brand h1 {
            font-size: 17px;
            color: var(--primary-dark);
        }

        .brand p {
            color: var(--muted);
            font-size: 12px;
            margin-top: 4px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .role-label {
            background: var(--primary-light);
            color: var(--primary);
            padding: 8px 13px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .main {
            max-width: 1450px;
            margin: auto;
            padding: 28px 25px 50px;
        }

        .page-heading {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 23px;
        }

        .page-heading h2 {
            font-size: 25px;
            margin-bottom: 8px;
        }

        .page-heading p {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .btn {
            border: 0;
            border-radius: 8px;
            padding: 10px 15px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-weight: 700;
            font-size: 13px;
            transition: .2s;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
        }

        .btn-light {
            background: #edf2f7;
            color: var(--text);
        }

        .btn-light:hover {
            background: #dfe7f1;
        }

        .btn:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

        .type-panel {
            background: white;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 17px;
            margin-bottom: 22px;
            box-shadow: var(--shadow);
        }

        .type-panel label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: var(--muted);
            margin-bottom: 10px;
        }

        .type-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .type-tab {
            border: 1px solid var(--border);
            background: white;
            color: #52627a;
            border-radius: 8px;
            padding: 11px 17px;
            font-size: 13px;
            font-weight: 700;
        }

        .type-tab.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 15px;
            margin-bottom: 22px;
        }

        .summary-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 18px;
            box-shadow: var(--shadow);
        }

        .summary-card .card-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .summary-card .card-label {
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
        }

        .summary-card .card-icon {
            width: 35px;
            height: 35px;
            display: grid;
            place-items: center;
            border-radius: 9px;
            background: var(--primary-light);
            color: var(--primary);
        }

        .summary-card .number {
            font-size: 27px;
            font-weight: 800;
            color: var(--text);
        }

        .summary-card .subtext {
            color: var(--muted);
            font-size: 11px;
            margin-top: 6px;
        }

        .section-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow);
            margin-bottom: 22px;
            overflow: hidden;
        }

        .section-header {
            padding: 19px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            border-bottom: 1px solid var(--border);
        }

        .section-header h3 {
            font-size: 16px;
            margin-bottom: 5px;
        }

        .section-header p {
            font-size: 12px;
            color: var(--muted);
        }

        .filters {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .search-box {
            position: relative;
        }

        .search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #9aa8ba;
            font-size: 13px;
        }

        .search-box input {
            width: 230px;
            padding: 10px 12px 10px 34px;
            border: 1px solid var(--border);
            border-radius: 8px;
            outline: none;
            font-size: 13px;
        }

        .search-box input:focus {
            border-color: var(--primary);
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 850px;
        }

        th, td {
            padding: 14px 16px;
            text-align: left;
            border-bottom: 1px solid #edf0f5;
            font-size: 12px;
            white-space: nowrap;
        }

        th {
            background: #f8faff;
            color: #65748b;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .35px;
        }

        tbody tr:hover {
            background: #fafcff;
        }

        tbody tr:last-child td {
            border-bottom: 0;
        }

        .school-name {
            font-weight: 700;
            color: var(--text);
        }

        .school-code {
            font-size: 11px;
            color: var(--muted);
            margin-top: 4px;
        }

        .progress-cell {
            min-width: 150px;
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .progress-track {
            height: 7px;
            background: #e9eef5;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            width: 0;
            background: var(--primary);
            border-radius: 10px;
            transition: width .3s;
        }

        .progress-fill.high {
            background: var(--success);
        }

        .progress-fill.medium {
            background: #d69e2e;
        }

        .progress-fill.low {
            background: var(--danger);
        }

        .percentage {
            font-weight: 800;
            font-size: 13px;
        }

        .status-pill {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
        }

        .status-complete {
            color: var(--success);
            background: var(--success-bg);
        }

        .status-progress {
            color: var(--warning);
            background: var(--warning-bg);
        }

        .status-pending {
            color: var(--danger);
            background: var(--danger-bg);
        }

        .view-btn {
            background: var(--primary-light);
            color: var(--primary);
            border: 0;
            border-radius: 7px;
            padding: 8px 11px;
            font-size: 11px;
            font-weight: 700;
        }

        .view-btn:hover {
            background: #d8e7ff;
        }

        .details-section {
            display: none;
        }

        .details-section.show {
            display: block;
        }

        .back-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 17px 20px;
            border-bottom: 1px solid var(--border);
            flex-wrap: wrap;
        }

        .selected-school h3 {
            font-size: 16px;
            margin-bottom: 5px;
        }

        .selected-school p {
            color: var(--muted);
            font-size: 12px;
        }

        .teacher-summary {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            padding: 17px 20px;
            background: #fbfcff;
            border-bottom: 1px solid var(--border);
        }

        .mini-card {
            border: 1px solid var(--border);
            border-radius: 9px;
            padding: 13px;
            background: white;
        }

        .mini-card span {
            display: block;
            font-size: 11px;
            color: var(--muted);
            margin-bottom: 7px;
        }

        .mini-card strong {
            font-size: 19px;
        }

        .teacher-cell strong {
            display: block;
            font-size: 12px;
        }

        .teacher-cell small {
            display: block;
            margin-top: 4px;
            color: var(--muted);
        }

        .empty-state {
            padding: 45px 20px;
            text-align: center;
            color: var(--muted);
        }

        .empty-state i {
            font-size: 30px;
            margin-bottom: 12px;
            color: #a9b7ca;
        }

        .empty-state h4 {
            color: var(--text);
            font-size: 14px;
            margin-bottom: 6px;
        }

        .empty-state p {
            font-size: 12px;
        }

        .loading {
            padding: 35px 20px;
            text-align: center;
            color: var(--muted);
            font-size: 13px;
        }

        .loading i {
            margin-right: 8px;
            color: var(--primary);
        }

        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 100;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .toast {
            background: #1e293b;
            color: white;
            padding: 13px 17px;
            border-radius: 8px;
            box-shadow: var(--shadow);
            font-size: 12px;
            max-width: 340px;
            animation: appear .2s ease;
        }

        .toast.error {
            background: #a92727;
        }

        .toast.success {
            background: #176b3c;
        }

        @keyframes appear {
            from {
                opacity: 0;
                transform: translateY(-8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 900px) {
            .summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .section-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .filters, .search-box, .search-box input {
                width: 100%;
            }
        }

        @media (max-width: 600px) {
            .topbar {
                padding: 13px 15px;
            }

            .brand h1 {
                font-size: 14px;
            }

            .role-label {
                display: none;
            }

            .main {
                padding: 20px 13px 35px;
            }

            .page-heading {
                flex-direction: column;
            }

            .page-heading h2 {
                font-size: 21px;
            }

            .summary-grid {
                gap: 9px;
            }

            .summary-card {
                padding: 13px;
            }

            .summary-card .number {
                font-size: 22px;
            }

            .teacher-summary {
                grid-template-columns: 1fr;
                padding: 13px;
            }

            .back-row {
                padding: 14px;
            }

            .section-header {
                padding: 15px;
            }
        }
    </style>
</head>

<body>

<header class="topbar">
    <div class="brand">
        <div class="brand-icon">
            <i class="fas fa-chart-column"></i>
        </div>
        <div>
            <h1>Fila Grades System</h1>
            <p>Sector Administration</p>
        </div>
    </div>

    <div class="topbar-right">
        <span class="role-label">SECTOR ADMIN</span>
    </div>
</header>

<main class="main">

    <div class="page-heading">
        <div>
            <h2>Inspect Marks Recording</h2>
            <p>
                Monitor marks-recording progress across schools in your sector
                and inspect individual teachers' recording performance.
            </p>
        </div>

        <button class="btn btn-light" id="refreshBtn" onclick="refreshData()">
            <i class="fas fa-rotate"></i>
            Refresh
        </button>
    </div>

    <section class="type-panel">
        <label>SELECT RECORDING CATEGORY</label>

        <div class="type-tabs">
            <button class="type-tab active"
                    data-type="tests"
                    onclick="changeRecordType('tests', this)">
                <i class="fas fa-file-lines"></i>
                Tests
            </button>

            <button class="type-tab"
                    data-type="examinations"
                    onclick="changeRecordType('examinations', this)">
                <i class="fas fa-graduation-cap"></i>
                Examinations
            </button>
        </div>
    </section>

    <section class="summary-grid">

        <div class="summary-card">
            <div class="card-top">
                <span class="card-label">TOTAL SCHOOLS</span>
                <div class="card-icon">
                    <i class="fas fa-school"></i>
                </div>
            </div>
            <div class="number" id="totalSchools">0</div>
            <div class="subtext">Schools in your sector</div>
        </div>

        <div class="summary-card">
            <div class="card-top">
                <span class="card-label">EXPECTED MARKS</span>
                <div class="card-icon">
                    <i class="fas fa-list-check"></i>
                </div>
            </div>
            <div class="number" id="expectedMarks">0</div>
            <div class="subtext">Total marks entries expected</div>
        </div>

        <div class="summary-card">
            <div class="card-top">
                <span class="card-label">RECORDED MARKS</span>
                <div class="card-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
            <div class="number" id="recordedMarks">0</div>
            <div class="subtext">Marks entries already recorded</div>
        </div>

        <div class="summary-card">
            <div class="card-top">
                <span class="card-label">MISSING MARKS</span>
                <div class="card-icon">
                    <i class="fas fa-hourglass-half"></i>
                </div>
            </div>
            <div class="number" id="missingMarks">0</div>
            <div class="subtext">Marks entries still outstanding</div>
        </div>

    </section>

    <!-- SCHOOL RANKING -->

    <section class="section-card" id="schoolsSection">

        <div class="section-header">
            <div>
                <h3>School Marks-Recording Performance</h3>
                <p>
                    Schools are ranked from highest to lowest completion percentage.
                </p>
            </div>

            <div class="filters">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="search"
                           id="schoolSearch"
                           placeholder="Search school..."
                           oninput="filterSchools()">
                </div>
            </div>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>School</th>
                        <th>Teachers</th>
                        <th>Expected</th>
                        <th>Recorded</th>
                        <th>Missing</th>
                        <th>Completion</th>
                        <th>Performance</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="schoolsTableBody">
                    <tr>
                        <td colspan="9">
                            <div class="loading">
                                <i class="fas fa-spinner fa-spin"></i>
                                Loading school performance...
