                    </tr>
                </tbody>
            </table>
        </div>

    </section>

    <!-- TEACHER SUBJECT AND CLASS BREAKDOWN -->

    <section class="section-card details-section" id="teacherBreakdownSection">

        <div class="back-row">
            <div class="selected-school">
                <h3 id="selectedTeacherName">Teacher Recording Details</h3>
                <p id="selectedTeacherDescription">
                    Marks-recording breakdown by class and subject
                </p>
            </div>

            <button class="btn btn-light" onclick="backToTeachers()">
                <i class="fas fa-arrow-left"></i>
                Back to Teachers
