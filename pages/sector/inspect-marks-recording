        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Class</th>
                        <th>Subject</th>
                        <th>Expected Marks</th>
                        <th>Recorded Marks</th>
                        <th>Missing Marks</th>
                        <th>Completion</th>
                    </tr>
                </thead>

                <tbody id="breakdownTableBody">
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <i class="fas fa-chart-pie"></i>
                                <h4>No details selected</h4>
                                <p>Select a teacher to view the breakdown.</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </section>

</main>

<div class="toast-container" id="toastContainer"></div>

<script>
/* =====================================================
   FILA GRADES SYSTEM
   SECTOR ADMIN — MARKS RECORDING INSPECTION
===================================================== */

const API_URL = "/api/inspect-marks-recording";

let currentRecordType = "tests";

let schools = [];
let teachers = [];
let teacherBreakdown = [];

let selectedSchool = null;
let selectedTeacher = null;


/* =====================================================
   GENERAL HELPERS
===================================================== */

function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
    })[char]);
}

function numberFormat(value) {
    return Number(value || 0).toLocaleString();
}

function percentage(value) {
    const result = Number(value || 0);

    if (!Number.isFinite(result)) return "0.0%";

    return Math.max(0, Math.min(100, result)).toFixed(1) + "%";
}

function getCompletionClass(value) {
    const result = Number(value || 0);

    if (result >= 90) return "high";
    if (result >= 50) return "medium";

    return "low";
}

function getPerformanceStatus(value) {
    const result = Number(value || 0);

    if (result >= 100) {
        return `<span class="status-pill status-complete">Complete</span>`;
    }

    if (result > 0) {
        return `<span class="status-pill status-progress">In Progress</span>`;
    }

    return `<span class="status-pill status-pending">Not Started</span>`;
}

function progressHTML(value) {
    const result = Math.max(0, Math.min(100, Number(value || 0)));
    const cssClass = getCompletionClass(result);

    return `
        <div class="progress-cell">
            <div class="progress-info">
                <span>${percentage(result)}</span>
            </div>
            <div class="progress-track">
                <div class="progress-fill ${cssClass}"
                     style="width:${result}%"></div>
            </div>
        </div>
    `;
}

function showToast(message, type = "success") {
    const container = document.getElementById("toastContainer");
    const toast = document.createElement("div");

    toast.className = "toast " + type;
    toast.textContent = message;

    container.appendChild(toast);

    setTimeout(() => {
        toast.remove();
    }, 3500);
}


/* =====================================================
   API REQUEST
===================================================== */

async function apiRequest(action, params = {}) {
    const query = new URLSearchParams({
        action,
        ...params
    });

    const response = await fetch(`${API_URL}?${query.toString()}`, {
        method: "GET",
        credentials: "same-origin",
        headers: {
            "Accept": "application/json"
        }
    });

    const result = await response.json().catch(() => null);

    if (!response.ok || !result) {
        throw new Error(
            result?.message || "Unable to communicate with the server."
        );
    }

    if (result.success === false) {
        throw new Error(result.message || "The request could not be completed.");
    }

    return result;
}


/* =====================================================
   LOAD SCHOOL PERFORMANCE
===================================================== */

async function loadSchoolPerformance() {
    const body = document.getElementById("schoolsTableBody");

    body.innerHTML = `
        <tr>
            <td colspan="9">
                <div class="loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    Loading school performance...
                </div>
            </td>
        </tr>
    `;

    try {
        const result = await apiRequest("get_school_progress", {
            record_type: currentRecordType
        });

        schools = result.schools || [];

        /*
         * The API is responsible for calculating completion
         * using actual expected entries and recorded marks.
         */

        schools.sort((a, b) =>
            Number(b.completion_percentage || 0) -
            Number(a.completion_percentage || 0)
        );

        renderSchools();
        updateSectorSummary(result.summary || calculateSummary(schools));

    } catch (error) {
        body.innerHTML = `
            <tr>
                <td colspan="9">
                    <div class="empty-state">
                        <i class="fas fa-triangle-exclamation"></i>
                        <h4>Unable to load school performance</h4>
                        <p>${escapeHTML(error.message)}</p>
                    </div>
                </td>
            </tr>
        `;

        showToast(error.message, "error");
    }
}


/* =====================================================
   SECTOR SUMMARY
===================================================== */

function calculateSummary(items) {
    return items.reduce((summary, item) => {
        summary.expected += Number(item.expected_marks || 0);
        summary.recorded += Number(item.recorded_marks || 0);
        summary.missing += Number(item.missing_marks || 0);

        return summary;
    }, {
        total_schools: items.length,
        expected_marks: 0,
        recorded_marks: 0,
        missing_marks: 0
    });
}

function updateSectorSummary(summary) {
    document.getElementById("totalSchools").textContent =
        numberFormat(summary.total_schools ?? schools.length);

    document.getElementById("expectedMarks").textContent =
        numberFormat(summary.expected_marks);

    document.getElementById("recordedMarks").textContent =
        numberFormat(summary.recorded_marks);

    document.getElementById("missingMarks").textContent =
        numberFormat(summary.missing_marks);
}


/* =====================================================
   RENDER SCHOOLS
===================================================== */

function renderSchools(list = schools) {
    const body = document.getElementById("schoolsTableBody");

    if (!list.length) {
        body.innerHTML = `
            <tr>
                <td colspan="9">
                    <div class="empty-state">
                        <i class="fas fa-school"></i>
                        <h4>No school records found</h4>
                        <p>There is no recording data available for this category.</p>
                    </div>
                </td>
            </tr>
        `;

        return;
    }

    body.innerHTML = list.map((school, index) => {
        const schoolId = Number(school.school_id);
        const completion = Number(school.completion_percentage || 0);

        return `
            <tr>
                <td><strong>${index + 1}</strong></td>

                <td>
                    <div class="school-name">
                        ${escapeHTML(school.school_name)}
                    </div>
                    <div class="school-code">
                        ${escapeHTML(school.school_code || "No school code")}
                    </div>
                </td>

                <td>${numberFormat(school.teacher_count)}</td>

                <td>${numberFormat(school.expected_marks)}</td>

                <td>${numberFormat(school.recorded_marks)}</td>

                <td>${numberFormat(school.missing_marks)}</td>

                <td>
                    <span class="percentage">
                        ${percentage(completion)}
                    </span>
                </td>

                <td>
                    ${getPerformanceStatus(completion)}
                    ${progressHTML(completion)}
                </td>

                <td>
                    <button class="view-btn"
                            onclick="viewSchoolTeachers(${schoolId})">
                        <i class="fas fa-users"></i>
                        View Teachers Recording
                    </button>
                </td>
            </tr>
        `;
    }).join("");
}


/* =====================================================
   SEARCH SCHOOLS
===================================================== */

function filterSchools() {
    const query = document.getElementById("schoolSearch")
        .value.trim().toLowerCase();

    const filtered = schools.filter(school => {
        return String(school.school_name || "")
            .toLowerCase()
            .includes(query) ||
            String(school.school_code || "")
            .toLowerCase()
            .includes(query);
    });

    renderSchools(filtered);
}


/* =====================================================
   VIEW TEACHERS IN A SCHOOL
===================================================== */

async function viewSchoolTeachers(schoolId) {
    selectedSchool = schools.find(
        school => Number(school.school_id) === Number(schoolId)
    );

    if (!selectedSchool) {
        showToast("School information could not be found.", "error");
        return;
    }

    document.getElementById("schoolsSection").style.display = "none";

    document.getElementById("teachersSection").classList.add("show");
    document.getElementById("teacherBreakdownSection").classList.remove("show");

    document.getElementById("selectedSchoolName").textContent =
        selectedSchool.school_name;

    document.getElementById("selectedSchoolDescription").textContent =
        `Teacher recording performance — ${currentRecordType === "tests" ? "Tests" : "Examinations"}`;

    document.getElementById("teacherSearch").value = "";

    const body = document.getElementById("teachersTableBody");

    body.innerHTML = `
        <tr>
            <td colspan="9">
                <div class="loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    Loading teachers...
                </div>
            </td>
        </tr>
    `;

    try {
        const result = await apiRequest("get_teacher_progress", {
            school_id: schoolId,
            record_type: currentRecordType
        });

        teachers = result.teachers || [];

        teachers.sort((a, b) =>
            Number(b.completion_percentage || 0) -
            Number(a.completion_percentage || 0)
        );

        renderTeachers();
        updateSchoolSummary(result.summary || calculateSummary(teachers));

    } catch (error) {
        body.innerHTML = `
            <tr>
                <td colspan="9">
                    <div class="empty-state">
                        <i class="fas fa-triangle-exclamation"></i>
                        <h4>Unable to load teachers</h4>
                        <p>${escapeHTML(error.message)}</p>
                    </div>
                </td>
            </tr>
        `;

        showToast(error.message, "error");
    }

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}


/* =====================================================
   SCHOOL SUMMARY
===================================================== */

function updateSchoolSummary(summary) {
    document.getElementById("schoolTeacherCount").textContent =
        numberFormat(summary.total_teachers ?? teachers.length);

    document.getElementById("schoolRecordedMarks").textContent =
        numberFormat(summary.recorded_marks);

    document.getElementById("schoolMissingMarks").textContent =
        numberFormat(summary.missing_marks);
}


/* =====================================================
   RENDER TEACHERS
===================================================== */

function renderTeachers(list = teachers) {
    const body = document.getElementById("teachersTableBody");

    if (!list.length) {
        body.innerHTML = `
            <tr>
                <td colspan="9">
                    <div class="empty-state">
                        <i class="fas fa-user-slash"></i>
                        <h4>No teacher records found</h4>
                        <p>No teachers have recording data for this category.</p>
                    </div>
                </td>
            </tr>
        `;

        return;
    }

    body.innerHTML = list.map((teacher, index) => {
        const completion = Number(teacher.completion_percentage || 0);

        return `
            <tr>
                <td><strong>${index + 1}</strong></td>

                <td>
                    <div class="teacher-cell">
                        <strong>${escapeHTML(teacher.full_name)}</strong>
                        <small>${escapeHTML(teacher.phone || "")}</small>
                    </div>
                </td>

                <td>${numberFormat(teacher.assigned_classes_count)}</td>

                <td>${numberFormat(teacher.assigned_subjects_count)}</td>

                <td>${numberFormat(teacher.expected_marks)}</td>

                <td>${numberFormat(teacher.recorded_marks)}</td>

                <td>${numberFormat(teacher.missing_marks)}</td>

                <td>
                    <span class="percentage">
                        ${percentage(completion)}
                    </span>
                    ${progressHTML(completion)}
                </td>

                <td>
                    <button class="view-btn"
                            onclick="viewTeacherBreakdown(${Number(teacher.teacher_id)})">
                        <i class="fas fa-eye"></i>
                        View Details
                    </button>
                </td>
            </tr>
        `;
    }).join("");
}


/* =====================================================
   SEARCH TEACHERS
===================================================== */

function filterTeachers() {
    const query = document.getElementById("teacherSearch")
        .value.trim().toLowerCase();

    const filtered = teachers.filter(teacher => {
        return String(teacher.full_name || "")
            .toLowerCase()
            .includes(query) ||
            String(teacher.phone || "")
            .toLowerCase()
            .includes(query);
    });

    renderTeachers(filtered);
}


/* =====================================================
   VIEW TEACHER CLASS/SUBJECT BREAKDOWN
===================================================== */

async function viewTeacherBreakdown(teacherId) {
    selectedTeacher = teachers.find(
        teacher => Number(teacher.teacher_id) === Number(teacherId)
    );

    if (!selectedTeacher || !selectedSchool) {
        showToast("Teacher information could not be found.", "error");
        return;
    }

    document.getElementById("teacherBreakdownSection").classList.add("show");

    document.getElementById("selectedTeacherName").textContent =
        selectedTeacher.full_name;

    document.getElementById("selectedTeacherDescription").textContent =
        `${selectedSchool.school_name} — Class and subject recording breakdown`;

    const body = document.getElementById("breakdownTableBody");

    body.innerHTML = `
        <tr>
            <td colspan="6">
                <div class="loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    Loading teacher recording details...
                </div>
            </td>
        </tr>
    `;

    try {
        const result = await apiRequest("get_teacher_breakdown", {
            school_id: selectedSchool.school_id,
            teacher_id: teacherId,
            record_type: currentRecordType
        });

        teacherBreakdown = result.breakdown || [];

        updateTeacherSummary(
            result.summary || selectedTeacher
        );

        renderTeacherBreakdown();

    } catch (error) {
        body.innerHTML = `
            <tr>
                <td colspan="6">
                    <div class="empty-state">
                        <i class="fas fa-triangle-exclamation"></i>
                        <h4>Unable to load recording details</h4>
                        <p>${escapeHTML(error.message)}</p>
                    </div>
                </td>
            </tr>
        `;

        showToast(error.message, "error");
    }

    document.getElementById("teacherBreakdownSection")
        .scrollIntoView({ behavior: "smooth", block: "start" });
}


/* =====================================================
   TEACHER SUMMARY
===================================================== */

function updateTeacherSummary(summary) {
    document.getElementById("teacherExpected").textContent =
        numberFormat(summary.expected_marks);

    document.getElementById("teacherRecorded").textContent =
        numberFormat(summary.recorded_marks);

    document.getElementById("teacherMissing").textContent =
        numberFormat(summary.missing_marks);
}


/* =====================================================
   RENDER CLASS/SUBJECT BREAKDOWN
===================================================== */

function renderTeacherBreakdown() {
    const body = document.getElementById("breakdownTableBody");

    if (!teacherBreakdown.length) {
        body.innerHTML = `
            <tr>
                <td colspan="6">
                    <div class="empty-state">
                        <i class="fas fa-clipboard-list"></i>
                        <h4>No recording breakdown available</h4>
                        <p>No assigned class and subject records were returned.</p>
                    </div>
                </td>
            </tr>
        `;

        return;
    }

    body.innerHTML = teacherBreakdown.map(item => {
        const completion = Number(item.completion_percentage || 0);

        return `
            <tr>
                <td><strong>${escapeHTML(item.class_name)}</strong></td>

                <td>${escapeHTML(item.subject_name)}</td>

                <td>${numberFormat(item.expected_marks)}</td>

                <td>${numberFormat(item.recorded_marks)}</td>

                <td>${numberFormat(item.missing_marks)}</td>

                <td>
                    <span class="percentage">
                        ${percentage(completion)}
                    </span>
                    ${progressHTML(completion)}
                </td>
            </tr>
        `;
    }).join("");
}


/* =====================================================
   NAVIGATION
===================================================== */

function backToSchools() {
    document.getElementById("teachersSection").classList.remove("show");
    document.getElementById("teacherBreakdownSection").classList.remove("show");

    document.getElementById("schoolsSection").style.display = "block";

    selectedSchool = null;
    selectedTeacher = null;

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}

function backToTeachers() {
    document.getElementById("teacherBreakdownSection").classList.remove("show");

    selectedTeacher = null;

    document.getElementById("teachersSection")
        .scrollIntoView({ behavior: "smooth", block: "start" });
}


/* =====================================================
   SWITCH BETWEEN TESTS AND EXAMINATIONS
===================================================== */

async function changeRecordType(type, button) {
    if (!["tests", "examinations"].includes(type)) return;

    if (currentRecordType === type) return;

    currentRecordType = type;

    document.querySelectorAll(".type-tab").forEach(tab => {
        tab.classList.remove("active");
    });

    button.classList.add("active");

    /*
     * Reset school and teacher details because the selected
     * recording category has changed.
     */

    selectedSchool = null;
    selectedTeacher = null;
    teachers = [];
    teacherBreakdown = [];

    document.getElementById("schoolsSection").style.display = "block";
    document.getElementById("teachersSection").classList.remove("show");
    document.getElementById("teacherBreakdownSection").classList.remove("show");

    document.getElementById("schoolSearch").value = "";

    await loadSchoolPerformance();
}


/* =====================================================
   REFRESH
===================================================== */

async function refreshData() {
    const button = document.getElementById("refreshBtn");

    button.disabled = true;
    button.innerHTML = `
        <i class="fas fa-spinner fa-spin"></i>
        Refreshing...
    `;

    try {
        await loadSchoolPerformance();

        if (selectedSchool) {
            await viewSchoolTeachers(selectedSchool.school_id);
        }

    } finally {
        button.disabled = false;
        button.innerHTML = `
            <i class="fas fa-rotate"></i>
            Refresh
        `;
    }
}


/* =====================================================
   INITIAL LOAD
===================================================== */

document.addEventListener("DOMContentLoaded", () => {
    loadSchoolPerformance();
});

</script>

