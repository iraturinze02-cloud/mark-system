        </div>

        <div class="teacher-summary">
            <div class="mini-card">
                <span>Expected Marks</span>
                <strong id="teacherExpected">0</strong>
            </div>

            <div class="mini-card">
                <span>Recorded Marks</span>
                <strong id="teacherRecorded">0</strong>
            </div>

            <div class="mini-card">
                <span>Missing Marks</span>
                <strong id="teacherMissing">0</strong>
